# Sanity CMS Configuration
VITE_SANITY_PROJECT_ID=w696z6zz
VITE_SANITY_DATASET=portfolio-thaiseboy
VITE_SANITY_API_VERSION=2023-01-01
VITE_SANITY_USE_CDN=true

# Do not put Sanity write tokens in VITE_* variables.
# Public portfolio reads should work without a token.

# Application Configuration
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=Portfolio

# Contact form (Resend), used by netlify/functions/contact.mjs on the server.
# Never prefix these with VITE_: that would ship the key to every visitor.
RESEND_API_KEY=
# Optional; defaults to get_sarun@hotmail.com
CONTACT_TO_EMAIL=
# Optional; needs a domain verified in Resend, e.g. contact@getdeveloper.nl
CONTACT_FROM_EMAIL=

# Studio inbox (netlify/functions/inbox-*.mjs), server-only like the key above.
# Sanity token with Editor rights; stores messages and replies.
SANITY_WRITE_TOKEN=
# For the reaction link in reply mails: `openssl rand -hex 32`
MESSAGE_SECRET=

# Local testing: `pnpm dev:netlify` (site + functions on http://localhost:8888) reads the
# variables above from this file, because Netlify does not hand out secret values locally.
# The Studio (`pnpm --dir studio dev`) sends replies there via studio/.env (see studio/.env.example).
