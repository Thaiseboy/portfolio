{
  "name": "portfolio-thaieboy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "serve": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:studio": "pnpm --dir studio install --frozen-lockfile && pnpm --dir studio exec sanity build ../dist/studio -y",
    "build:all": "pnpm run build && pnpm run build:studio",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.16.0",
    "bootstrap-icons": "^1.13.2",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/estree": "^1.0.10",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
